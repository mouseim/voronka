      "id": "demo_formula",
      "type": "formula",
      "data": {
        "title": "Рассчитать приоритет",
        "note": "",
        "enabled": true,
        "analyticsTags": [],
        "abGroup": "",
        "expression": {
          "id": "formula_add",
          "kind": "binary",
          "operator": "+",
          "left": {
            "id": "formula_source",
            "kind": "variable",
            "key": "lead_score"
          },
          "right": {
            "id": "formula_bonus",
            "kind": "number",
            "value": 4
          }
        },
        "targetVariableKey": "lead_score"
      }

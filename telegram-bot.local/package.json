{
  "name": "voronka-telegram-runtime",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup src/main.ts --format esm --target node22 --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "fastify": "^5.6.2",
    "grammy": "^1.38.3",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.12",
    "@types/pg": "^8.15.6",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.7.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
